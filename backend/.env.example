# Modelo do arquivo de configuração do E.L.O.
#
# Como usar: copie este arquivo com o nome ".env" (na mesma pasta backend/)
# e troque os valores. O .env NÃO vai para o GitHub (está no .gitignore),
# porque guarda senhas e chaves.

# Chave usada pelo Flask para assinar o cookie da sessão.
# Se alguém descobrir essa chave, consegue falsificar um login.
# Gere uma chave aleatória com:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave

# Caminho do arquivo do banco SQLite (criado pelo seed.py).
DATABASE_PATH=instance/elo.db

# Primeiro administrador, criado pelo seed.py.
# A senha fica só aqui, nunca escrita no código.
ADMIN_EMAIL=admin@elo.exemplo
ADMIN_SENHA=troque-esta-senha

# Senha dos usuários de demonstração criados pelo seed.py
# (e-mails fictícios, listados no README).
DEMO_SENHA=troque-esta-senha-demo

# Modo de desenvolvimento do Flask: mostra erros detalhados e recarrega
# o servidor quando o código muda. Use 0 fora do ambiente de estudo.
FLASK_DEBUG=1
